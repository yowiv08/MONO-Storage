{
  "name": "mono-storage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-local.mjs && npm run build && concurrently -k -n api,web \"wrangler dev --local --ip 127.0.0.1 --port 8787\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "node scripts/prepare-local.mjs && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.ts",
    "verify": "node scripts/verify-api.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.154.0"
  }
}
